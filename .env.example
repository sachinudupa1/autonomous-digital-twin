# ============================================================
# EXAMPLE CONFIGURATION ONLY
# Copy relevant values into local .env files when required.
# Never put real passwords, tokens or service-account keys here.
# ============================================================

# ---------------- BACKEND ----------------

APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated local frontend development origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ---------------- FIREBASE ----------------

FIREBASE_PROJECT_ID=your-firebase-project-id

# Local development only. Keep the actual service-account JSON
# outside Git and configure its path privately.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json

# ---------------- FRONTEND ----------------

VITE_API_BASE_URL=http://127.0.0.1:8000

# Firebase web application configuration placeholders.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# ---------------- LOCAL PYTHON BRIDGE ----------------

# For local development, use the local backend URL.
# When the backend is deployed, configure the appropriate HTTPS URL.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Replace locally with a securely generated secret.
BRIDGE_AUTH_TOKEN=replace-with-a-local-development-token

# CoppeliaSim is accessed locally by the Python bridge.
# Never expose this port publicly.
COPPELIASIM_ZMQ_HOST=127.0.0.1
COPPELIASIM_ZMQ_PORT=23000
