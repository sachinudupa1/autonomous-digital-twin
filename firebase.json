{
    "hosting":  [
                    {
                        "target":  "customer",
                        "public":  "apps/customer-website/dist",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ]
                    },
                    {
                        "target":  "dashboard",
                        "public":  "apps/dashboard/dist",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ]
                    },
                    {
                        "target":  "health-controls",
                        "public":  "apps/health-controls/dist",
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "rewrites":  [
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ]
                    }
                ],
    "firestore":  {
                      "rules":  "database/firestore.rules",
                      "indexes":  "database/firestore.indexes.json"
                  }
}